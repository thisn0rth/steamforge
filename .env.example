# StreamForge server configuration (all optional; sensible local defaults apply)

# HTTP + WebSocket port for the control UI / API
PORT=4500
# Bind host. Keep 127.0.0.1 for a local-only tool; use 0.0.0.0 to expose on LAN.
HOST=127.0.0.1

# Where rigs/overlays/transitions JSON is stored
# STREAMFORGE_DATA_DIR=./data

# Optional shared token CS2 must include in its GSI config (leave empty to disable)
# STREAMFORGE_GSI_TOKEN=

# Shared team password for remote operators. Leave empty for local-only use.
# When set, remote (non-loopback) clients must sign in with this password;
# the production host (loopback) is always trusted and never prompted.
# STREAMFORGE_TEAM_PASSWORD=

# OBS WebSocket (Tools -> WebSocket Server Settings in OBS)
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
OBS_AUTO_CONNECT=false
