# StreamForge server configuration (all optional; sensible local defaults apply)

# HTTP + WebSocket port for the control UI / API
PORT=4500
# Bind host. Keep 127.0.0.1 for a local-only tool; use 0.0.0.0 to expose on LAN.
HOST=127.0.0.1

# Where rigs/overlays/transitions JSON is stored
# STREAMFORGE_DATA_DIR=./data

# Optional shared token CS2 must include in its GSI config (leave empty to disable)
# STREAMFORGE_GSI_TOKEN=

# Shared team password for remote operators. Leave empty for local-only use.
# When set, remote (non-loopback) clients must sign in with this password;
# the production host (loopback) is always trusted and never prompted.
# STREAMFORGE_TEAM_PASSWORD=

# OBS WebSocket (Tools -> WebSocket Server Settings in OBS)
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
OBS_AUTO_CONNECT=false

# Single shared OBS browser source the app drives. Its URL is flipped between
# /preview (while staging) and /live (when pushed) so you only add one
# "Overlay" source per scene. Set AUTOSWITCH=false to keep two fixed sources.
STREAMFORGE_OVERLAY_SOURCE=Overlay
STREAMFORGE_OVERLAY_AUTOSWITCH=true
# Base URL OBS uses to reach the render pages (defaults to http://localhost:PORT)
# STREAMFORGE_OVERLAY_BASE_URL=http://localhost:4500

# Live Program/Preview monitor previews (screenshots streamed from OBS to all
# operators). Lower fps/quality/width to reduce CPU on the production host.
# Capture only runs while at least one client is connected.
STREAMFORGE_PREVIEW_FPS=6
STREAMFORGE_PREVIEW_WIDTH=480
STREAMFORGE_PREVIEW_QUALITY=50

# Highlights / auto-clip montages need ffmpeg on the host. It's auto-detected on
# PATH and in common install locations (e.g. winget on Windows). Only set this if
# detection fails — point it at the ffmpeg binary or its bin directory.
# STREAMFORGE_FFMPEG=C:\Program Files\ffmpeg\bin\ffmpeg.exe

# Firestore league data (optional). Overlays can bind to per-player/team/match
# fields you maintain in Firestore. Disabled unless credentials are provided.
# Provide EITHER the inline service-account JSON or a path to the JSON file.
# FIRESTORE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
# FIRESTORE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIRESTORE_PROJECT_ID=
# Collection names (defaults shown)
# FIRESTORE_PLAYERS_COLLECTION=players
# FIRESTORE_TEAMS_COLLECTION=teams
# FIRESTORE_MATCHES_COLLECTION=matches
# Auto-refresh interval in ms (0 disables periodic refresh)
# FIRESTORE_REFRESH_MS=60000
